<% form.fields_for :settings, form.object.settings do |settings_fields| %>
  <div class="row column">
    <%= settings_fields.text_field :title_text, label: t("decidim.content_blocks.processes_list_settings_form.title") %>
  </div>

   <div class="row column">
    <%= settings_fields.text_field :description_text, label: t("decidim.content_blocks.processes_list_settings_form.description") %>
  </div>

  <div class="row column">
    <%= settings_fields.text_field :button_url, label: t("decidim.content_blocks.cta_settings_form.button_url") %>
  </div>

  <div class="row column">
    <%= settings_fields.text_field :button_text, label: t("decidim.content_blocks.processes_list_settings_form.button_text") %>
  </div>

   <div class="row column">
    <%= settings_fields.text_field :subtitle_text, label: t("decidim.content_blocks.processes_list_settings_form.subtitle") %>
  </div>
<% end %>
